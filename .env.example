# Story Animator configuration. Copy to `.env` and fill in your keys.
# Every setting except the API keys has a sensible default.
# Full reference: docs/CONFIGURATION.md

# ---------- Storyboard writer (LLM) ----------
# At least one key is needed to generate from a topic.
# (Rendering a hand-written storyboard needs no LLM.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=auto                  # auto (Gemini, then DeepSeek) | gemini | deepseek

# ---------- Narration (ElevenLabs) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=               # empty = first premade voice on your account
ELEVENLABS_MODEL=eleven_v4        # v3/v4 follow audio tags like [excited] for expressive delivery
TTS_PROVIDER=elevenlabs            # elevenlabs | silent (free previews, estimated timing)
TTS_CONCURRENCY=3

# ---------- Channel ----------
MIN_TOPIC_FIT=6                    # topics scoring below this (1-10) vs the niche are refused unless --force

# ---------- Visual style ----------
VISUAL_STYLE=diagram               # diagram (3Blue1Brown-like, serif, LaTeX) | infographic (flat icons)
CUSTOM_SCENES=1                    # let the AI write one-off diagram scenes (validated, with fallbacks)
CUSTOM_ATTEMPTS=3                  # write -> validate -> fix rounds per custom scene

# ---------- Video ----------
TARGET_DURATION_SECS=300           # every video is exactly this long (>= 120 is written in chapters)
ASPECT=landscape                   # landscape (16:9) | portrait (9:16, Shorts/Reels/TikTok)
SHORTS=1                           # also cut a 9:16 short from every landscape video
SHORT_MAX_SECS=59
RENDER_QUALITY=high                # draft 540p15 | standard 720p30 | high 1080p30 | ultra 1080p60
TRANSITION_SECS=0.5                # crossfade length between scenes
MAX_SPEECH_TEMPO=1.15              # max speed-up applied if narration runs long

# ---------- Audio ----------
BACKGROUND_MUSIC=library           # library (assets/music, fill once with `story_animator music`) | none | elevenlabs (per video) | path/to/track.mp3
MUSIC_VOLUME=0.07                  # kept low, and ducked further under the voice
BURN_SUBTITLES=1
SUBTITLE_FONT=Poppins              # bundled in assets/fonts

# ---------- Rendering ----------
PYTHON_BIN=                        # empty = ./venv's python, else python/python3
RENDER_CONCURRENCY=                # empty = half your CPU cores (max 4)
RENDER_TIMEOUT_SECS=900
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---------- Server ----------
SERVER_ADDR=0.0.0.0:3000
MAX_CONCURRENT_JOBS=1

# ---------- Logging ----------
LOG_JSON=0
RUST_LOG=info
